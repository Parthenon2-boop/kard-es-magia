; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Kard és Mágia"
config/description="Roguelike kaland a katakombákban: lovag, mágus vagy íjász, öt mélység."
config/version="2.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.png"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/size/resizable=true
window/stretch/mode="disabled"
; Függőleges szinkron bekapcsolva: szakadásmentes, egyenletes 60 kép/mp.
; Egy képkocka rajzolása most ~7-14 ms, tehát bőven belefér a 16,6 ms-os keretbe.
window/vsync/vsync_mode=1

[physics]

; A játék körökre osztott, fizikát egyáltalán nem használ: elég a legritkább ütem.
common/physics_ticks_per_second=20
common/max_physics_steps_per_frame=2

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.031, 0.024, 0.016, 1)
; Az Apple Silicon (arm64) és az univerzális macOS export ezt megköveteli.
textures/vram_compression/import_etc2_astc=true